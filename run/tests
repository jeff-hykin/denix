#!/usr/bin/env -S deno run --allow-all
// tests — run every pure-setup eval task through nix-instantiate and
// denix_eval, writing each pair's output next to the corresponding .nix
// file.
//
// Usage:
//     ./run/tests [--silent]
//
// For each eval_tasks_pure_setup/<stem>_eval.json + <stem>.nix, this
// writes the following into eval_tasks_pure_setup/ :
//     <stem>.nix.out    (stdout from real nix-instantiate)
//     <stem>.nix.err    (stderr from real nix-instantiate)
//     <stem>.js.out     (stdout from ./run/denix_eval)
//     <stem>.js.err     (stderr from ./run/denix_eval)
//
// Exits 0 regardless of per-task match/mismatch — this script is a
// report, not a gate.

const repoRoot = new URL("..", import.meta.url).pathname.replace(/\/$/, "")
const PURE_DIR = `${repoRoot}/tests/translation/eval_tasks_pure_setup`
const denixEvalPath = `${repoRoot}/run/denix_eval`

const argv = [...Deno.args]

if (argv.includes("--help") || argv.includes("-h")) {
    console.log(`\
Usage: ./run/tests [OPTIONS]

Run pure-setup and complex eval tasks, comparing nix-instantiate vs denix_eval.

Options:
  --silent, -s       Suppress per-task output (only print summaries)
  --pure-only        Run only pure_setup tasks (skip complex tests)
  --complex-only     Run only complex tests (skip pure_setup tasks)
  --positive-only    Run only eval-okay-* tasks (skip eval-fail-*)
  --timeout <sec>    Per-task timeout in seconds (default: 10)
  --help, -h         Show this help message

For each eval_tasks_pure_setup/<stem>_eval.json + <stem>.nix, writes:
  <stem>.nix.out     stdout from real nix-instantiate
  <stem>.nix.err     stderr from real nix-instantiate
  <stem>.js.out      stdout from denix_eval
  <stem>.js.err      stderr from denix_eval
  <stem>.fail        created on mismatch, removed on match

Complex tests (eval_tasks_complex/) are standalone Deno scripts that
exit 0 on pass, 1 on fail. Results are written to _results.json.`)
    Deno.exit(0)
}

const silent = argv.includes("--silent") || argv.includes("-s")
const complexOnly = argv.includes("--complex-only")
const pureOnly = argv.includes("--pure-only")
const positiveOnly = argv.includes("--positive-only")
let timeout = 10_000 // ms
{
    const i = argv.indexOf("--timeout")
    if (i >= 0) {
        timeout = Number(argv[i + 1]) * 1000
        argv.splice(i, 2)
    }
}
const log = silent ? () => {} : (...a) => console.log(...a)

// --------------------------------------------------------------
// discover tasks
// --------------------------------------------------------------
const tasks = []
for await (const entry of Deno.readDir(PURE_DIR)) {
    if (entry.isFile && entry.name.endsWith("_eval.json")) {
        const stem = entry.name.replace(/_eval\.json$/, "")
        if (positiveOnly && !stem.startsWith("eval-okay")) continue
        tasks.push({
            stem,
            jsonPath: `${PURE_DIR}/${entry.name}`,
            nixPath:  `${PURE_DIR}/${stem}.nix`,
        })
    }
}
tasks.sort((a, b) => a.stem < b.stem ? -1 : a.stem > b.stem ? 1 : 0)

if (complexOnly) tasks.length = 0
log(`discovered ${tasks.length} tasks in ${PURE_DIR}`)

// --------------------------------------------------------------
// helpers
// --------------------------------------------------------------
const decoder = new TextDecoder()

// Normalize run-specific temp paths so output is stable across runs.
// e.g. "denix_eval_ba307d0005eaee1/" → "denix_eval/"
const TEMP_DIR_RE = /denix_eval(?:_expr)?_[a-f0-9]+\//g
function sanitizeOutput(text) {
    return text.replace(TEMP_DIR_RE, "denix_eval/")
}

async function runNix(setup, signal) {
    const env = { ...setup.env }
    delete env["NIX_EVAL_SHIM_REAL"]
    delete env["NIX_EVAL_SHIM_RECORD_DIR"]
    delete env["NIX_EVAL_SHIM_SCRIPT"]
    const proc = new Deno.Command(setup.argv[0], {
        args: setup.argv.slice(1),
        cwd: setup.cwd,
        env,
        clearEnv: true,
        stdout: "piped", stderr: "piped",
        signal,
    })
    const { stdout, stderr, code } = await proc.output()
    return { stdout: decoder.decode(stdout), stderr: decoder.decode(stderr), code }
}

async function runDenix(setup, jsPath, signal) {
    // Forward test env + minimally-needed parent-env shims for deno itself.
    const subEnv = { ...setup.env }
    for (const k of ["DENO_DIR", "DENO_INSTALL_ROOT", "XDG_CACHE_HOME"]) {
        const v = Deno.env.get(k); if (v != null) subEnv[k] = v
    }
    for (const k of ["HOME", "PATH", "TMPDIR"]) {
        if (subEnv[k] == null) {
            const v = Deno.env.get(k); if (v != null) subEnv[k] = v
        }
    }
    if (!subEnv["DENO_DIR"]) {
        const ph = Deno.env.get("HOME")
        if (ph) subEnv["DENO_DIR"] = `${ph}/.cache/deno`
    }
    const proc = new Deno.Command(Deno.execPath(), {
        args: ["run", "--allow-all", "--quiet", denixEvalPath,
               "--emit-translated", jsPath,
               ...setup.argv.slice(1)],
        cwd: setup.cwd,
        env: subEnv,
        clearEnv: true,
        stdout: "piped", stderr: "piped",
        signal,
    })
    const { stdout, stderr, code } = await proc.output()
    return { stdout: decoder.decode(stdout), stderr: decoder.decode(stderr), code }
}

// --------------------------------------------------------------
// main loop
// --------------------------------------------------------------
let matched = 0
let mismatched = 0
let errored = 0

for (let i = 0; i < tasks.length; i++) {
    const t = tasks[i]
    let setup
    try {
        setup = JSON.parse(await Deno.readTextFile(t.jsonPath))
    } catch (err) {
        errored++
        log(`[${i+1}/${tasks.length}] ERR ${t.stem}: ${err.message}`)
        continue
    }

    // Delete any stale translated-JS artifact from a prior run so that its
    // presence is a signal that translation succeeded on this run.
    const jsPath = `${PURE_DIR}/${t.stem}.js`
    try { await Deno.remove(jsPath) } catch {}

    const signal = AbortSignal.timeout(timeout)
    let nixRes, denixRes
    try {
        nixRes   = await runNix(setup, signal)
    } catch (err) {
        if (err.name === "AbortError" || err.name === "TimeoutError") {
            errored++
            log(`[${i+1}/${tasks.length}] TIMEOUT(nix) ${t.stem}`)
            continue
        }
        throw err
    }
    try {
        denixRes = await runDenix(setup, jsPath, signal)
    } catch (err) {
        if (err.name === "AbortError" || err.name === "TimeoutError") {
            errored++
            log(`[${i+1}/${tasks.length}] TIMEOUT(js) ${t.stem}`)
            continue
        }
        throw err
    }

    nixRes.stdout   = sanitizeOutput(nixRes.stdout)
    nixRes.stderr   = sanitizeOutput(nixRes.stderr)
    denixRes.stdout = sanitizeOutput(denixRes.stdout)
    denixRes.stderr = sanitizeOutput(denixRes.stderr)
    await Deno.writeTextFile(`${PURE_DIR}/${t.stem}.nix.out`, nixRes.stdout)
    await Deno.writeTextFile(`${PURE_DIR}/${t.stem}.nix.err`, nixRes.stderr)
    await Deno.writeTextFile(`${PURE_DIR}/${t.stem}.js.out`,  denixRes.stdout)
    await Deno.writeTextFile(`${PURE_DIR}/${t.stem}.js.err`,  denixRes.stderr)

    const match = nixRes.stdout === denixRes.stdout
    const failPath = `${PURE_DIR}/${t.stem}.fail`
    if (match) {
        matched++
        try { await Deno.remove(failPath) } catch {}
    } else {
        mismatched++
        await Deno.writeTextFile(failPath, `nix exit: ${nixRes.code}\njs exit:  ${denixRes.code}\n`)
    }

    if (!silent) {
        const mark = match ? "✓" : "✗"
        log(`[${i+1}/${tasks.length}] ${mark} ${t.stem}`)
    }
}

// Final summary for pure_setup (always printed, even when silent)
console.log(`\npure_setup: ${matched} match / ${mismatched} mismatch / ${errored} err / ${tasks.length} total`)

// --------------------------------------------------------------
// eval_tasks_complex — run each .js file in-process.
// Every test is a standalone Deno script that exits 0 on pass.
// Results are grouped by category (top-level dir under eval_tasks_complex).
// --------------------------------------------------------------
const COMPLEX_DIR = `${repoRoot}/tests/translation/eval_tasks_complex`
if (pureOnly) Deno.exit(0)

async function listJsTests(dir, out, category) {
    for await (const entry of Deno.readDir(dir)) {
        if (entry.name === "shared_tooling") continue
        if (entry.name.startsWith("_")) continue
        const full = `${dir}/${entry.name}`
        if (entry.isDirectory) {
            const nextCategory = category ?? entry.name
            await listJsTests(full, out, nextCategory)
        } else if (entry.isFile && entry.name.endsWith(".js")) {
            out.push({ path: full, category: category ?? "root" })
        }
    }
}

const complexTests = []
try {
    await listJsTests(COMPLEX_DIR, complexTests, null)
} catch {}
complexTests.sort((a, b) => a.path < b.path ? -1 : a.path > b.path ? 1 : 0)

const perCategory = new Map()
for (const t of complexTests) {
    if (!perCategory.has(t.category)) perCategory.set(t.category, { pass: 0, fail: 0, total: 0 })
}

const results = { categories: {}, failures: [] }

for (let i = 0; i < complexTests.length; i++) {
    const t = complexTests[i]
    const proc = new Deno.Command(Deno.execPath(), {
        args: ["run", "--allow-all", "--quiet", t.path],
        stdout: "piped", stderr: "piped",
    })
    const { code, stdout, stderr } = await proc.output()
    const bucket = perCategory.get(t.category)
    bucket.total += 1
    if (code === 0) { bucket.pass += 1 }
    else {
        bucket.fail += 1
        results.failures.push({
            path: t.path.replace(repoRoot + "/", ""),
            code,
            stdout: decoder.decode(stdout),
            stderr: decoder.decode(stderr),
        })
    }
    if (!silent) {
        const mark = code === 0 ? "✓" : "✗"
        log(`[${i+1}/${complexTests.length}] ${mark} ${t.category}/${t.path.split("/").pop()}`)
    }
}

for (const [cat, c] of perCategory) {
    results.categories[cat] = c
    const pad = cat.padEnd(18, " ")
    console.log(`${pad} ${c.pass} pass / ${c.fail} fail / ${c.total} total`)
}

// Persist results for later inspection.
try {
    await Deno.mkdir(COMPLEX_DIR, { recursive: true })
    await Deno.writeTextFile(
        `${COMPLEX_DIR}/_results.json`,
        JSON.stringify(results, null, 2) + "\n",
    )
} catch {}
