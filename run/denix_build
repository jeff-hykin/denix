#!/usr/bin/env -S deno run --allow-all
// denix_build — denix's equivalent of `nix-build` / `nix build`.
//
// Evaluates a nix expression to a derivation, then realizes it using
// main/builder.js. Prints the output path(s) to stdout.
//
// Usage (mirrors nix-build):
//     denix_build [flags] <file.nix>
//     denix_build -E '<nixpkgs> { }'
//
// Supported flags:
//     -A <attr.path>         select attribute from result
//     --expr / -E <expr>     evaluate inline expression
//     --arg <name> <expr>    bind arg to evaluated nix expr
//     --argstr <name> <str>  bind arg to literal string
//     -I <path>              add to NIX_PATH
//     -o <link> / --out-link <link>   create symlink to output (default: ./result)
//     --no-out-link / --no-link       don't create symlink
//     -f <file> / --file <file>       evaluate file (same as positional)
//     --json                 print output paths as JSON
//     --dry-run              only evaluate, don't build
//     --show-trace           (ignored — placeholder)
//     --impure               (ignored — placeholder)
//     --check                (ignored — placeholder, rebuild even if cached)
//     --keep-going / -k      (ignored — placeholder)
//     -j <n> / --max-jobs <n> (ignored — placeholder)
//     --no-link              alias for --no-out-link
//     --store <url>          (ignored — placeholder)
//     --option <k> <v>       (ignored — placeholder)
//
// Environment:
//     DENIX_STORE_ROOT       relocatable store directory (default: ~/.cache/denix/store)
//
// Exits 0 on success, 1 on build failure, 2 on arg error.

import { convertToJs } from "../translator.js"

const argv = [...Deno.args]

// --------------------------------------------------------------
// arg parser
// --------------------------------------------------------------
const passThroughNoArg = new Set([
    "--show-trace", "--no-show-trace", "--impure", "--check",
    "--keep-going", "-k", "--keep-failed", "-K",
    "--quiet", "-Q", "--verbose", "-v", "-vv", "-vvv", "-vvvv", "-vvvvv",
])
const passThroughOneArg = new Set([
    "--max-call-depth", "--timeout", "--store",
])

let nixFile = null
let inlineExpr = null
let jsonMode = false
let dryRun = false
let outLink = "./result"
let noOutLink = false
const attrPath = []
const includes = []
const args = {}
const unknownFlags = []

for (let i = 0; i < argv.length; i++) {
    const a = argv[i]
    if (a === "--json") { jsonMode = true; continue }
    if (a === "--dry-run") { dryRun = true; continue }
    if (a === "--no-out-link" || a === "--no-link") { noOutLink = true; continue }
    if (a === "-o" || a === "--out-link") { outLink = argv[++i]; continue }
    if (a === "-A" || a === "--attr") {
        const path = argv[++i]
        if (path) for (const p of path.split(".")) attrPath.push(p)
        continue
    }
    if (a === "-f" || a === "--file") { nixFile = argv[++i]; continue }
    if (a === "-I") { includes.push(argv[++i]); continue }
    if (a === "--expr" || a === "-E") { inlineExpr = argv[++i]; continue }
    if (a === "--arg") {
        const name = argv[++i]; const expr = argv[++i]
        args[name] = { kind: "expr", value: expr }
        continue
    }
    if (a === "--argstr") {
        const name = argv[++i]; const value = argv[++i]
        args[name] = { kind: "str", value }
        continue
    }
    if (a === "-j" || a === "--max-jobs") { i += 1; continue }
    if (a === "--option") { i += 2; continue }
    if (passThroughNoArg.has(a)) continue
    if (passThroughOneArg.has(a)) { i += 1; continue }
    if (a.startsWith("-") && a !== "-") { unknownFlags.push(a); continue }
    if (!nixFile) { nixFile = a; continue }
}

if (!nixFile && inlineExpr == null) {
    console.error("denix_build: no .nix file or --expr given")
    Deno.exit(2)
}

// --------------------------------------------------------------
// resolve nix file
// --------------------------------------------------------------
let nixFileAbs
let inlineTmpDir = null
if (nixFile) {
    try {
        nixFileAbs = await Deno.realPath(nixFile)
    } catch (err) {
        console.error(`denix_build: cannot resolve ${JSON.stringify(nixFile)}: ${err.message}`)
        Deno.exit(1)
    }
} else {
    inlineTmpDir = await Deno.makeTempDir({ prefix: "denix_build_expr_" })
    nixFileAbs = `${inlineTmpDir}/expr.nix`
    await Deno.writeTextFile(nixFileAbs, inlineExpr)
}

// --------------------------------------------------------------
// translate & evaluate
// --------------------------------------------------------------
let translated
try {
    const source = await Deno.readTextFile(nixFileAbs)
    const runtimeAbs = new URL("../main/runtime.js", import.meta.url).href
    translated = await convertToJs(source, { runtimePath: runtimeAbs, sourceFile: nixFileAbs })
} catch (err) {
    console.error(`denix_build: translation failed: ${err instanceof Error ? (err.stack ?? err.message) : String(err)}`)
    Deno.exit(1)
}

const tmpDir = await Deno.makeTempDir({ prefix: "denix_build_" })
const tmpJs = `${tmpDir}/translated.js`
await Deno.writeTextFile(tmpJs, translated)

let value
try {
    const mod = await import("file://" + tmpJs)
    value = mod.default
    if (value && typeof value.then === "function") value = await value
} catch (err) {
    console.error(`denix_build: eval failed: ${err instanceof Error ? (err.stack ?? err.message) : String(err)}`)
    cleanup(); Deno.exit(1)
}

// --------------------------------------------------------------
// apply --arg / --argstr
// --------------------------------------------------------------
if (Object.keys(args).length > 0 && typeof value === "function") {
    try {
        const argObj = {}
        for (const [name, spec] of Object.entries(args)) {
            if (spec.kind === "str") argObj[name] = spec.value
            else argObj[name] = null  // TODO: evaluate nix expr
        }
        value = value(argObj)
        if (value && typeof value.then === "function") value = await value
    } catch (err) {
        console.error(`denix_build: --arg application failed: ${err.message}`)
        cleanup(); Deno.exit(1)
    }
}

// --------------------------------------------------------------
// -A attr path traversal
// --------------------------------------------------------------
for (const part of attrPath) {
    if (value == null) break
    value = value[part]
    if (value && typeof value.then === "function") value = await value
}

// --------------------------------------------------------------
// check we got a derivation
// --------------------------------------------------------------
if (!value || value.type !== "derivation") {
    console.error(`denix_build: expression does not evaluate to a derivation (got ${typeof value}${value?.type ? `, type=${value.type}` : ""})`)
    cleanup(); Deno.exit(1)
}

// --------------------------------------------------------------
// dry run — just print the drv path
// --------------------------------------------------------------
if (dryRun) {
    if (jsonMode) {
        console.log(JSON.stringify({ drvPath: value.drvPath, outputs: value.outputs }))
    } else {
        console.log(value.drvPath)
    }
    cleanup(); Deno.exit(0)
}

// --------------------------------------------------------------
// build
// --------------------------------------------------------------
const { build } = await import("../main/builder.js")

let result
try {
    result = await build(value, { verbose: true })
} catch (err) {
    console.error(`denix_build: build failed: ${err.message}`)
    cleanup(); Deno.exit(1)
}

// --------------------------------------------------------------
// output
// --------------------------------------------------------------
const outPaths = Object.values(result.outputPaths)

if (jsonMode) {
    console.log(JSON.stringify({
        outputPaths: result.outputPaths,
        cached: result.cached,
    }))
} else {
    for (const p of outPaths) {
        console.log(p)
    }
}

// --------------------------------------------------------------
// create out-link symlink
// --------------------------------------------------------------
if (!noOutLink && outLink) {
    const primary = outPaths[0]
    if (primary) {
        try {
            try { await Deno.remove(outLink) } catch { /* doesn't exist */ }
            await Deno.symlink(primary, outLink)
        } catch (err) {
            console.error(`denix_build: warning: could not create symlink ${outLink}: ${err.message}`)
        }
    }
}

cleanup()
Deno.exit(0)

// --------------------------------------------------------------
function cleanup() {
    try { Deno.removeSync(tmpDir, { recursive: true }) } catch {}
    if (inlineTmpDir) { try { Deno.removeSync(inlineTmpDir, { recursive: true }) } catch {} }
}
